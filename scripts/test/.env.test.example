# Interdict manual test environment
# Copy to .env.test and fill in your keys — never commit .env.test
#
#   cp scripts/test/.env.test.example scripts/test/.env.test

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Interdict proxy (matches KERNEL_LISTEN_ADDR)
INTERDICT_PROXY=http://localhost:8443

# Path to Interdict's generated CA cert (created on first boot)
INTERDICT_CA_CERT=./ca.crt

# Vendor to hit
TEST_VENDOR_URL=https://api.openai.com/v1/chat/completions

# Model to use
TEST_MODEL=gpt-4o-mini
