{
  "mcpServers": {
    "interdict-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${CLAUDE_PROJECT_DIR}"
      ]
    },
    "interdict-git": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/git-mcp-server"
      ],
      "env": {
        "MCP_LOG_LEVEL": "error",
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    },
    "interdict-docker": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-docker"
      ],
      "env": {
        "ALLOWED_CONTAINERS": "kernel:interdict-kernel,control-plane:interdict-control-plane,dashboard:interdict-dashboard",
        "DEFAULT_SERVICE": "kernel"
      }
    },
    "interdict-kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-kubernetes"
      ]
    },
    "interdict-wasmtime": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/scripts/mcp/wasmtime_server.mjs"
      ],
      "env": {
        "INTERDICT_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    },
    "interdict-crypto": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR}/scripts/mcp/crypto_server.mjs"
      ]
    }
  }
}
