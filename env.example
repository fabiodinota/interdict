# ==============================================================================
# Interdict Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# This file is the single source of truth shared between Docker Compose
# and future Helm chart values (Phase 12).
#
# Usage: cp env.example .env && docker compose up
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection URL for PostgreSQL. Used by control plane.
DATABASE_URL=postgres://interdict:interdict@postgres:5432/interdict
# PostgreSQL superuser credentials (set by Postgres container)
POSTGRES_USER=interdict
POSTGRES_PASSWORD=interdict
POSTGRES_DB=interdict

# ------------------------------------------------------------------------------
# Analytics Database (ClickHouse)
# ------------------------------------------------------------------------------
# ClickHouse HTTP interface URL. Used by control plane and evidence collector.
CLICKHOUSE_URL=http://clickhouse:8123
# ClickHouse database name.
CLICKHOUSE_DATABASE=interdict

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
# MinIO root credentials
MINIO_ROOT_USER=interdict
MINIO_ROOT_PASSWORD=interdict-minio-secret
# S3 endpoint URL (MinIO in Docker, real S3 in production)
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=interdict
AWS_SECRET_ACCESS_KEY=interdict-minio-secret
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Kernel Proxy
# ------------------------------------------------------------------------------
# Listen address for the proxy (host:port)
KERNEL_LISTEN_ADDR=0.0.0.0:8443
# Upstream connection timeout in milliseconds
KERNEL_CONNECT_TIMEOUT_MS=10000
# First byte timeout in milliseconds
KERNEL_FIRST_BYTE_TIMEOUT_MS=30000
# Overall stream timeout in milliseconds (5 min default for AI streaming)
KERNEL_STREAM_TIMEOUT_MS=300000
# Maximum request queue size before returning 503
KERNEL_MAX_REQUEST_QUEUE=1024
# TLS CA certificate path (auto-generated on first boot if missing)
KERNEL_CA_CERT_PATH=/data/certs/ca.crt
# TLS CA key path
KERNEL_CA_KEY_PATH=/data/certs/ca.key
# Connection pool: max HTTP/2 connections per vendor
KERNEL_POOL_MAX_CONNECTIONS=4
# Connection pool: max concurrent streams per connection
KERNEL_POOL_MAX_STREAMS=100
# Connection pool: idle connection timeout in milliseconds
KERNEL_POOL_IDLE_TIMEOUT=60000
# Allowed AI vendor domains (TOML inline array format)
KERNEL_ALLOWLIST_VENDORS=["api.openai.com","api.anthropic.com"]
# Log level: debug, info, warn, error
KERNEL_LOG_LEVEL=info
# Log format: json (production) or pretty (development)
KERNEL_LOG_FORMAT=json
# SQLite path for human review queue
KERNEL_REVIEW_DB_PATH=/data/review_queue.db
# Directory containing Rego policy source files
KERNEL_POLICIES_DIR=/app/policies/
# Control plane gRPC address for policy distribution
KERNEL_DISTRIBUTION_ADDR=http://control-plane:50052
# Organization ID for policy hierarchy
KERNEL_ORG_ID=default
# Force regenerate TOML from template even if interdict.toml exists
KERNEL_FORCE_TEMPLATE=false

# ------------------------------------------------------------------------------
# Control Plane API
# ------------------------------------------------------------------------------
# HTTP API port
PORT=3000
# Directory for compiled Wasm policy modules
WASM_STORAGE_DIR=./data/wasm
# Path to OPA binary (pre-installed in container image)
OPA_BINARY_PATH=opa
# gRPC distribution server port
INTERDICT_GRPC_PORT=50052
# Maximum gRPC message size in bytes (default 16 MB)
INTERDICT_GRPC_MAX_MESSAGE_SIZE=16777216

# ------------------------------------------------------------------------------
# Evidence Collector
# ------------------------------------------------------------------------------
# gRPC listen address (must bind to 0.0.0.0 or [::] for Docker networking)
COLLECTOR_GRPC_LISTEN_ADDR=[::]:50051
# S3 bucket for Merkle tree anchor storage
COLLECTOR_S3_BUCKET=interdict-evidence
# S3 region
COLLECTOR_S3_REGION=us-east-1
# Signing mode: dev (ephemeral key), file (key from path), kms (AWS KMS)
COLLECTOR_SIGNING_MODE=dev
# Path to Ed25519 signing key (used when COLLECTOR_SIGNING_MODE=file)
COLLECTOR_SIGNING_KEY_PATH=/data/keys/signing.key
# Merkle tree rotation window in seconds (1 hour default)
COLLECTOR_MERKLE_WINDOW_SECS=3600
# Maximum leaves per Merkle tree before rotation
COLLECTOR_MERKLE_MAX_LEAVES=1000000
# Store full request/response text (false = hashes only)
COLLECTOR_FULL_TEXT_STORAGE=false
# Evidence retention in days (7 years default)
COLLECTOR_RETENTION_DAYS=2555

# ------------------------------------------------------------------------------
# Kernel -> Evidence Collector Connection
# ------------------------------------------------------------------------------
# Address the kernel uses to reach evidence collector gRPC
KERNEL_EVIDENCE_COLLECTOR_ADDR=http://evidence-collector:50051
