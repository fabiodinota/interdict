# ==============================================================================
# Interdict Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your deployment.
# This file is the single source of truth shared between Docker Compose
# and Helm chart deployment.
#
# Usage: cp env.example .env && docker compose up
#
# !! PRODUCTION WARNING !!
# The default passwords in this file are for local development only.
# Before deploying to any non-local environment you MUST change every
# value marked with "# CHANGE IN PRODUCTION" below. Running with
# default credentials in production is a critical security risk.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection URL for PostgreSQL. Used by control plane.
DATABASE_URL=postgres://interdict:interdict@postgres:5432/interdict  # CHANGE IN PRODUCTION
# PostgreSQL superuser credentials (set by Postgres container)
POSTGRES_USER=interdict
POSTGRES_PASSWORD=interdict  # CHANGE IN PRODUCTION
POSTGRES_DB=interdict

# ------------------------------------------------------------------------------
# Analytics Database (ClickHouse)
# ------------------------------------------------------------------------------
# ClickHouse HTTP interface URL. Used by control plane and evidence collector.
CLICKHOUSE_URL=http://clickhouse:8123
# ClickHouse database name.
CLICKHOUSE_DATABASE=interdict
# ClickHouse username.
CLICKHOUSE_USER=default
# ClickHouse password.
CLICKHOUSE_PASSWORD=interdict  # CHANGE IN PRODUCTION

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
# MinIO root credentials
MINIO_ROOT_USER=interdict
MINIO_ROOT_PASSWORD=interdict-minio-secret  # CHANGE IN PRODUCTION
# S3 endpoint URL (MinIO in Docker, real S3 in production)
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=interdict  # CHANGE IN PRODUCTION
AWS_SECRET_ACCESS_KEY=interdict-minio-secret  # CHANGE IN PRODUCTION
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Kernel Proxy
# ------------------------------------------------------------------------------
# Listen address for the proxy (host:port)
KERNEL_LISTEN_ADDR=0.0.0.0:8443
# Upstream connection timeout in milliseconds
KERNEL_CONNECT_TIMEOUT_MS=10000
# First byte timeout in milliseconds
KERNEL_FIRST_BYTE_TIMEOUT_MS=30000
# Overall stream timeout in milliseconds (5 min default for AI streaming)
KERNEL_STREAM_TIMEOUT_MS=300000
# Maximum request queue size before returning 503
KERNEL_MAX_REQUEST_QUEUE=1024
# TLS CA certificate path (auto-generated on first boot if missing)
KERNEL_CA_CERT_PATH=/data/certs/ca.crt
# TLS CA key path
KERNEL_CA_KEY_PATH=/data/certs/ca.key
# Connection pool: max HTTP/2 connections per vendor
KERNEL_POOL_MAX_CONNECTIONS=4
# Connection pool: max concurrent streams per connection
KERNEL_POOL_MAX_STREAMS=100
# Connection pool: idle connection timeout in milliseconds
KERNEL_POOL_IDLE_TIMEOUT=60000
# Allowed AI vendor domains (TOML inline array format)
KERNEL_ALLOWLIST_VENDORS=["api.openai.com","api.anthropic.com"]
# Log level: debug, info, warn, error
KERNEL_LOG_LEVEL=info
# Log format: json (production) or pretty (development)
KERNEL_LOG_FORMAT=json
# SQLite path for human review queue
KERNEL_REVIEW_DB_PATH=/data/review_queue.db
# Directory containing Rego policy source files
KERNEL_POLICIES_DIR=/app/policies/
# Control plane gRPC address for policy distribution
KERNEL_DISTRIBUTION_ADDR=https://control-plane:50052
# Organization ID for policy hierarchy
KERNEL_ORG_ID=default
# Force regenerate TOML from template even if interdict.toml exists
KERNEL_FORCE_TEMPLATE=false

# ------------------------------------------------------------------------------
# Control Plane API
# ------------------------------------------------------------------------------
# HTTP API port
PORT=3000
# Directory for compiled Wasm policy modules
WASM_STORAGE_DIR=./data/wasm
# Path to OPA binary (pre-installed in container image)
OPA_BINARY_PATH=opa
# gRPC distribution server port
INTERDICT_GRPC_PORT=50052
# Maximum gRPC message size in bytes (default 16 MB)
INTERDICT_GRPC_MAX_MESSAGE_SIZE=16777216

# ------------------------------------------------------------------------------
# Evidence Collector
# ------------------------------------------------------------------------------
# gRPC listen address (must bind to 0.0.0.0 or [::] for Docker networking)
COLLECTOR_GRPC_LISTEN_ADDR=[::]:50051
# S3 bucket for Merkle tree anchor storage
COLLECTOR_S3_BUCKET=interdict-evidence
# S3 region
COLLECTOR_S3_REGION=us-east-1
# Signing mode: dev (ephemeral key), file (key from path), kms (AWS KMS)
COLLECTOR_SIGNING_MODE=dev
# Path to Ed25519 signing key (used when COLLECTOR_SIGNING_MODE=file)
COLLECTOR_SIGNING_KEY_PATH=/data/keys/signing.key
# Merkle tree rotation window in seconds (1 hour default)
COLLECTOR_MERKLE_WINDOW_SECS=3600
# Maximum leaves per Merkle tree before rotation
COLLECTOR_MERKLE_MAX_LEAVES=1000000
# Store full request/response text (false = hashes only)
COLLECTOR_FULL_TEXT_STORAGE=false
# Evidence retention in days (7 years default)
COLLECTOR_RETENTION_DAYS=2555
# Require S3 Object Lock verification when anchoring is enabled.
COLLECTOR_REQUIRE_OBJECT_LOCK=true

# ------------------------------------------------------------------------------
# Kernel -> Evidence Collector Connection
# ------------------------------------------------------------------------------
# Address the kernel uses to reach evidence collector gRPC
KERNEL_EVIDENCE_COLLECTOR_ADDR=https://evidence-collector:50051

# ------------------------------------------------------------------------------
# mTLS Configuration (Internal gRPC Channels)
# ------------------------------------------------------------------------------
# Toggle mTLS for all internal gRPC channels (true in Docker, false for local dev)
MTLS_ENABLED=true
# Internal CA certificate path (shared trust anchor for all services)
MTLS_CA_CERT_PATH=/certs/internal-ca.pem
# Service-specific cert/key paths (set per-service in docker-compose.yml)
# MTLS_CERT_PATH=/certs/<service>.pem
# MTLS_KEY_PATH=/certs/<service>-key.pem

# Kernel mTLS client certificate paths
KERNEL_MTLS_CA_CERT=/certs/internal-ca.pem
KERNEL_MTLS_CLIENT_CERT=/certs/kernel-client.pem
KERNEL_MTLS_CLIENT_KEY=/certs/kernel-client-key.pem

# ------------------------------------------------------------------------------
# SAML SSO Configuration
# ------------------------------------------------------------------------------
# To enable SAML SSO:
#   1. Set vars below and bind-mount your IdP metadata XML to ./config/idp-metadata.xml
#   2. Run cert-init (automatic on first boot) to generate SAML SP cert
#   3. Rebuild dashboard image with NEXT_PUBLIC_SAML_ENABLED=true
#   4. SAML auto-enables when saml-sp.key, saml-sp.crt, and idp-metadata.xml all exist
#
# SP entity ID, must match IdP configuration
SAML_SP_ENTITY_ID=http://localhost:3001/api/v1/auth/saml/metadata
# Control plane external URL for SAML ACS callback
SAML_SP_BASE_URL=http://localhost:3001
# Path to SAML SP private key (auto-generated by cert-init)
SAML_SP_KEY_PATH=/certs/saml-sp.key
# Path to SAML SP certificate (auto-generated by cert-init)
SAML_SP_CERT_PATH=/certs/saml-sp.crt
# Path to IdP metadata XML -- bind-mount your IdP's metadata file to ./config/idp-metadata.xml
SAML_IDP_METADATA_PATH=/config/idp-metadata.xml
# Dashboard URL for post-SSO redirect
DASHBOARD_URL=http://localhost:8080
# Set to 'true' to show SSO login button in dashboard.
# NOTE: requires dashboard image rebuild since Next.js inlines NEXT_PUBLIC_ at build time
NEXT_PUBLIC_SAML_ENABLED=false
# Control plane URL for browser SSO redirects.
# NOTE: requires dashboard image rebuild
NEXT_PUBLIC_API_URL=http://localhost:3001
# Control plane URL used by the dashboard server for backchannel API requests.
CONTROL_PLANE_URL=http://control-plane:3000

# ------------------------------------------------------------------------------
# Signing Key Rotation
# ------------------------------------------------------------------------------
# Path where control plane writes rotated signing keys (shared volume with evidence-collector)
SIGNING_KEY_OUTPUT_PATH=/data/keys/signing.key
# Path evidence-collector watches for signing key changes (30s poll)
SIGNING_KEY_WATCH_PATH=/data/keys/signing.key
# After first admin-triggered rotation (POST /api/v1/admin/signing-keys/rotate),
# the evidence-collector hot-reloads the new key.
# COLLECTOR_SIGNING_MODE remains 'dev' until first rotation.
