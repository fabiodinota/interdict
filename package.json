{
  "private": true,
  "name": "interdict",
  "description": "AI governance kernel for regulated enterprises",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9",
    "lint-staged": "^16"
  },
  "lint-staged": {
    "crates/**/*.rs": [
      "echo Rust files staged -- cargo fmt/clippy checked in CI or run locally via WSL2"
    ],
    "control-plane/src/**/*.{ts,tsx,js,jsx}": [
      "control-plane/node_modules/.bin/biome check --fix --no-errors-on-unmatched"
    ],
    "dashboard/src/**/*.{ts,tsx,js,jsx}": [
      "dashboard/node_modules/.bin/prettier --write",
      "dashboard/node_modules/.bin/eslint --fix"
    ],
    "dashboard/src/**/*.css": [
      "dashboard/node_modules/.bin/prettier --write"
    ]
  }
}
