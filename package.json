{
  "private": true,
  "name": "interdict",
  "description": "AI governance kernel for regulated enterprises",
  "scripts": {
    "prepare": "husky",
    "lint:infra": "bash scripts/quality/infra-check.sh",
    "lint:infra:staged": "bash scripts/quality/infra-check.sh --staged",
    "verify:rust:wsl": "bash scripts/quality/rust-wsl-check.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9",
    "lint-staged": "^16"
  },
  "lint-staged": {
    "crates/**/*.rs": [
      "sh -c 'command -v cargo >/dev/null 2>&1 && cargo fmt -- --check || echo \"[lint-staged] cargo not found — skipping Rust format check (run in WSL2 or install Rust)\"'"
    ],
    "control-plane/src/**/*.{ts,tsx,js,jsx}": [
      "sh -c 'cd control-plane && ./node_modules/.bin/biome check --fix ./src'"
    ],
    "dashboard/src/**/*.{ts,tsx,js,jsx}": [
      "sh -c 'cd dashboard && ./node_modules/.bin/prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"'",
      "sh -c 'cd dashboard && ./node_modules/.bin/eslint --fix src'"
    ],
    "dashboard/src/**/*.css": [
      "sh -c 'cd dashboard && ./node_modules/.bin/prettier --write \"src/**/*.css\"'"
    ]
  }
}
