# interdict.toml.template -- Generated by entrypoint from env vars
#
# All ${VAR} placeholders are substituted by envsubst at container startup.
# Defaults are set in entrypoint.sh before envsubst runs.

[proxy]
listen_addr = "${KERNEL_LISTEN_ADDR}"
connect_timeout_ms = ${KERNEL_CONNECT_TIMEOUT_MS}
first_byte_timeout_ms = ${KERNEL_FIRST_BYTE_TIMEOUT_MS}
stream_timeout_ms = ${KERNEL_STREAM_TIMEOUT_MS}
max_request_queue = ${KERNEL_MAX_REQUEST_QUEUE}

[tls]
ca_cert_path = "${KERNEL_CA_CERT_PATH}"
ca_key_path = "${KERNEL_CA_KEY_PATH}"

[pool]
max_connections_per_vendor = ${KERNEL_POOL_MAX_CONNECTIONS}
max_streams_per_connection = ${KERNEL_POOL_MAX_STREAMS}
idle_timeout_ms = ${KERNEL_POOL_IDLE_TIMEOUT}

[allowlist]
vendors = ${KERNEL_ALLOWLIST_VENDORS}

[logging]
level = "${KERNEL_LOG_LEVEL}"
format = "${KERNEL_LOG_FORMAT}"

[policy]
review_db_path = "${KERNEL_REVIEW_DB_PATH}"
policies_dir = "${KERNEL_POLICIES_DIR}"

[policy.distribution]
distribution_addr = "${KERNEL_DISTRIBUTION_ADDR}"
org_id = "${KERNEL_ORG_ID}"
